//! Turn a hex nibble into the pattern for a seven-segment display.

//> `SevenSegment` decodes one hex nibble into the seven-segment
//> pattern that displays it: one output bit per segment, set when
//> that segment should glow.
pub mod SevenSegment {
    // The digit to show, 0x0 through 0xF.
    incoming digit : Word[4]

    // Seven segments, seven bits. A real display is seven little
    // bars named by convention:
    //
    //        aaaa
    //       f    b
    //       f    b
    //        gggg
    //       e    c
    //       e    c
    //        dddd
    //
    // `segments` hands each bar its own bit: bit 0 drives segment
    // `a`, bit 1 drives `b`, and so on up to bit 6 for `g`. So a
    // pattern written in binary reads left to right as `g f e d
    // c b a`. This display is active-high: 1 means "glow".
    outgoing segments : Word[7] dependson digit {
        // The whole decoder is one lookup table: `match` walks the
        // nibble through all sixteen patterns. Sixteen arms cover
        // every value a Word[4] can hold, so no `else` is needed.
        it := match digit {
            with 0x0 => 0b0111111
            with 0x1 => 0b0000110
            with 0x2 => 0b1011011
            with 0x3 => 0b1001111
            with 0x4 => 0b1100110
            with 0x5 => 0b1101101
            with 0x6 => 0b1111101
            with 0x7 => 0b0000111
            with 0x8 => 0b1111111
            with 0x9 => 0b1101111
            // Hex runs out of digits at F, but a seven-segment
            // display can still spell them. Note the lowercase
            // `b` and `d`: uppercase would be unreadable next to
            // the 8 and the 0.
            with 0xA => 0b1110111
            with 0xB => 0b1111100
            with 0xC => 0b0111001
            with 0xD => 0b1011110
            with 0xE => 0b1111001
            with 0xF => 0b1110001
        }
    }
}
