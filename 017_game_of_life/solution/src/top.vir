//! Conway's Game of Life, blooming on a 4x4 garden of registers.

//> `GameOfLife` grows a 4x4 colony, one generation per clock edge:
//> a dead cell with exactly three live neighbors is born, a live
//> cell with two or three survives, and every other cell fades.
pub mod GameOfLife {
    incoming clock : Clock

    // Planting: with `load` high, the grid takes `pattern` at the
    // next clock edge. If `load` and `step` ever arrive together,
    // the first arm wins and the new pattern is planted.
    incoming load : Bit
    incoming pattern : Word[16]
    incoming step : Bit

    // The whole colony lives in this one register. Row r, column c
    // is bit 4r + c: row 0 is the lowest nibble, and bit 15 is the
    // bottom-right corner.
    reg cells : Word[16] {
        initial it <= 0
        if {
            when load {
                it <= pattern
            }
            when step {
                it <= next_generation
            }
        }
    }

    outgoing grid : Word[16] {
        it := cells
    }

    // Outside the 4x4 grid the garden is forever fallow: border
    // cells simply have fewer neighbors, and no neighbor is ever
    // fetched from beyond the hedge.
    //
    // Notice that every `next_*` wire below reads only `cells`, the
    // current generation. The whole next board is worked out at
    // once, and a single clock edge swaps all sixteen cells in
    // together -- no cell updates before its neighbors are heard.
    wire next_generation : Word[16] {
        it := word(next_row3, next_row2, next_row1, next_row0)
    }

    wire next_row3 : Word[4] { it := word(next_3_3, next_3_2, next_3_1, next_3_0) }
    wire next_row2 : Word[4] { it := word(next_2_3, next_2_2, next_2_1, next_2_0) }
    wire next_row1 : Word[4] { it := word(next_1_3, next_1_2, next_1_1, next_1_0) }
    wire next_row0 : Word[4] { it := word(next_0_3, next_0_2, next_0_1, next_0_0) }

    // A neighbor is a single `Bit`; `word(0w3, ...)` pads it up to a
    // Word[4] so a cell's neighbors can be counted with `+`.

    // Cell (0,0) -- bit 0, the top-left corner: neighbors 1, 4, 5.
    wire next_0_0 : Bit {
        let count : Word[4] = word(0w3, cells[1]) + word(0w3, cells[4]) + word(0w3, cells[5]) {
            it := if {
                when count == 3 => true
                when count == 2 => cells[0]
                else => false
            }
        }
    }

    // Cell (0,1) -- bit 1: neighbors 0, 2, 4, 5, 6.
    wire next_0_1 : Bit {
        let count : Word[4] = word(0w3, cells[0]) + word(0w3, cells[2])
            + word(0w3, cells[4]) + word(0w3, cells[5]) + word(0w3, cells[6]) {
            it := if {
                when count == 3 => true
                when count == 2 => cells[1]
                else => false
            }
        }
    }

    // Cell (0,2) -- bit 2: neighbors 1, 3, 5, 6, 7.
    wire next_0_2 : Bit {
        let count : Word[4] = word(0w3, cells[1]) + word(0w3, cells[3])
            + word(0w3, cells[5]) + word(0w3, cells[6]) + word(0w3, cells[7]) {
            it := if {
                when count == 3 => true
                when count == 2 => cells[2]
                else => false
            }
        }
    }

    // Cell (0,3) -- bit 3, the top-right corner: neighbors 2, 6, 7.
    wire next_0_3 : Bit {
        let count : Word[4] = word(0w3, cells[2]) + word(0w3, cells[6]) + word(0w3, cells[7]) {
            it := if {
                when count == 3 => true
                when count == 2 => cells[3]
                else => false
            }
        }
    }

    // Cell (1,0) -- bit 4: neighbors 0, 1, 5, 8, 9.
    wire next_1_0 : Bit {
        let count : Word[4] = word(0w3, cells[0]) + word(0w3, cells[1])
            + word(0w3, cells[5]) + word(0w3, cells[8]) + word(0w3, cells[9]) {
            it := if {
                when count == 3 => true
                when count == 2 => cells[4]
                else => false
            }
        }
    }

    // Cell (1,1) -- bit 5: neighbors 0, 1, 2, 4, 6, 8, 9, 10.
    wire next_1_1 : Bit {
        let count : Word[4] = word(0w3, cells[0]) + word(0w3, cells[1])
            + word(0w3, cells[2]) + word(0w3, cells[4]) + word(0w3, cells[6])
            + word(0w3, cells[8]) + word(0w3, cells[9]) + word(0w3, cells[10]) {
            it := if {
                when count == 3 => true
                when count == 2 => cells[5]
                else => false
            }
        }
    }

    // Cell (1,2) -- bit 6: neighbors 1, 2, 3, 5, 7, 9, 10, 11.
    wire next_1_2 : Bit {
        let count : Word[4] = word(0w3, cells[1]) + word(0w3, cells[2])
            + word(0w3, cells[3]) + word(0w3, cells[5]) + word(0w3, cells[7])
            + word(0w3, cells[9]) + word(0w3, cells[10]) + word(0w3, cells[11]) {
            it := if {
                when count == 3 => true
                when count == 2 => cells[6]
                else => false
            }
        }
    }

    // Cell (1,3) -- bit 7, the right-hand edge: neighbors 2, 3, 6, 10, 11.
    wire next_1_3 : Bit {
        let count : Word[4] = word(0w3, cells[2]) + word(0w3, cells[3])
            + word(0w3, cells[6]) + word(0w3, cells[10]) + word(0w3, cells[11]) {
            it := if {
                when count == 3 => true
                when count == 2 => cells[7]
                else => false
            }
        }
    }

    // Cell (2,0) -- bit 8: neighbors 4, 5, 9, 12, 13.
    wire next_2_0 : Bit {
        let count : Word[4] = word(0w3, cells[4]) + word(0w3, cells[5])
            + word(0w3, cells[9]) + word(0w3, cells[12]) + word(0w3, cells[13]) {
            it := if {
                when count == 3 => true
                when count == 2 => cells[8]
                else => false
            }
        }
    }

    // Cell (2,1) -- bit 9: neighbors 4, 5, 6, 8, 10, 12, 13, 14.
    wire next_2_1 : Bit {
        let count : Word[4] = word(0w3, cells[4]) + word(0w3, cells[5])
            + word(0w3, cells[6]) + word(0w3, cells[8]) + word(0w3, cells[10])
            + word(0w3, cells[12]) + word(0w3, cells[13]) + word(0w3, cells[14]) {
            it := if {
                when count == 3 => true
                when count == 2 => cells[9]
                else => false
            }
        }
    }

    // Cell (2,2) -- bit 10: neighbors 5, 6, 7, 9, 11, 13, 14, 15.
    wire next_2_2 : Bit {
        let count : Word[4] = word(0w3, cells[5]) + word(0w3, cells[6])
            + word(0w3, cells[7]) + word(0w3, cells[9]) + word(0w3, cells[11])
            + word(0w3, cells[13]) + word(0w3, cells[14]) + word(0w3, cells[15]) {
            it := if {
                when count == 3 => true
                when count == 2 => cells[10]
                else => false
            }
        }
    }

    // Cell (2,3) -- bit 11, the right-hand edge: neighbors 6, 7, 10, 14, 15.
    wire next_2_3 : Bit {
        let count : Word[4] = word(0w3, cells[6]) + word(0w3, cells[7])
            + word(0w3, cells[10]) + word(0w3, cells[14]) + word(0w3, cells[15]) {
            it := if {
                when count == 3 => true
                when count == 2 => cells[11]
                else => false
            }
        }
    }

    // Cell (3,0) -- bit 12, the bottom edge: neighbors 8, 9, 13.
    wire next_3_0 : Bit {
        let count : Word[4] = word(0w3, cells[8]) + word(0w3, cells[9]) + word(0w3, cells[13]) {
            it := if {
                when count == 3 => true
                when count == 2 => cells[12]
                else => false
            }
        }
    }

    // Cell (3,1) -- bit 13, the bottom edge: neighbors 8, 9, 10, 12, 14.
    wire next_3_1 : Bit {
        let count : Word[4] = word(0w3, cells[8]) + word(0w3, cells[9])
            + word(0w3, cells[10]) + word(0w3, cells[12]) + word(0w3, cells[14]) {
            it := if {
                when count == 3 => true
                when count == 2 => cells[13]
                else => false
            }
        }
    }

    // Cell (3,2) -- bit 14, the bottom edge: neighbors 9, 10, 11, 13, 15.
    wire next_3_2 : Bit {
        let count : Word[4] = word(0w3, cells[9]) + word(0w3, cells[10])
            + word(0w3, cells[11]) + word(0w3, cells[13]) + word(0w3, cells[15]) {
            it := if {
                when count == 3 => true
                when count == 2 => cells[14]
                else => false
            }
        }
    }

    // Cell (3,3) -- bit 15, the bottom-right corner: neighbors 10, 11, 14.
    wire next_3_3 : Bit {
        let count : Word[4] = word(0w3, cells[10]) + word(0w3, cells[11]) + word(0w3, cells[14]) {
            it := if {
                when count == 3 => true
                when count == 2 => cells[15]
                else => false
            }
        }
    }
}
